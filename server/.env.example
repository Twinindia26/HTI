PORT=5000
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Clerk configuration
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# Postgres configuration
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secure admin bootstrap
ADMIN_EMAIL=

# Optional Resend email delivery for private script upload alerts
RESEND_API_KEY=
EMAIL_FROM=

# Private script upload allowlists (default: .js,.py,.sh,.sql,.txt; 1 MiB)
UPLOAD_SCRIPT_EXTENSIONS=.js,.py,.sh,.sql,.txt
UPLOAD_SCRIPT_MIME_TYPES=application/javascript,text/javascript,text/x-python,text/x-shellscript,application/sql,text/plain
UPLOAD_SCRIPT_MAX_BYTES=1048576
